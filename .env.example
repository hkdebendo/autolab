# Copy this file to .env and fill in your own keys. Never commit .env (it is ignored by Git).
# AutoLab on your computer: python scripts/run_autolab.py (see the README: the keys below, and Modal for new researches).

# Meta Model API (https://dev.meta.ai): Muse Spark (proposals, decisions, failure analysis, report, literature check),
# Muse Wonder (campaign review) and Muse Voice Transcribe (dictation)
MODEL_API_KEY=
# Baseten: Muse Spark Open (independent reviews of the candidates, fallback of Muse Spark)
BASETEN_API_KEY=
# Fireworks: Muse Glimmer (plain-language summaries), on a dedicated deployment named by GLIMMER_DEPLOYMENT
FIREWORKS_API_KEY=
GLIMMER_DEPLOYMENT=       # accounts/<account>/deployments/<id> (not a secret)
# Materials Project (https://next-gen.materialsproject.org/api): known phases and reference energies
MP_API_KEY=
# Hugging Face: the UMA weights (Meta FAIR, gated: accept the FAIR Chemistry License on huggingface.co/facebook/UMA)
HF_TOKEN=

LLM_PROVIDER=meta         # meta | baseten | fireworks
SIM_BACKEND=modal         # modal | local (local = machine with an NVIDIA GPU, e.g. Colab)
AUTOLAB_API_URL=          # address of the AutoLab service on Modal (printed by modal deploy), read by web/app.py
